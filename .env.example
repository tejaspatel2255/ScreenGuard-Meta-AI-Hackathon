# Copy this file to .env and fill in the values. Never commit .env.

# Which model provider the judging model uses: meta or baseten
PROVIDER=meta

# Meta Model API (take the exact values from the official docs; see docs/meta_api_notes.md)
META_API_KEY=
META_API_BASE_URL=

# Optional: Baseten (only if partner credits are granted)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# mock = fake responses for development only. real = real model calls. replay = recorded real outputs.
MODE=mock

# Feature flags
USE_SAM=true
USE_VOICE=false

# Cost and safety limits
MAX_CALLS_PER_SESSION=60
MAX_CALLS_PER_MINUTE=10
# Keep this well below the $150 credits. A credit card is on the account, so stay under the credit.
MAX_ESTIMATED_SPEND_USD=100

# Agent thresholds
CONFIDENCE_ADVANCE=0.7
CONFIDENCE_HIGH_RISK=0.85
WARNING_COOLDOWN_SECONDS=8
