# Copy this file to .env and fill in the values. Never commit .env.

# Which model provider the judging model uses: groq, meta or baseten
PROVIDER=groq

# Groq Provider (serving Meta open-weights models)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Meta Model API (take the exact values from the official docs; see docs/meta_api_notes.md)
META_API_KEY=
META_API_BASE_URL=

# Optional: Baseten (only if partner credits are granted)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# mock = fake responses for development only. real = real model calls. replay = recorded real outputs.
MODE=mock

# Feature flags
USE_SAM=false
USE_VOICE=false

# Cost and safety limits
MAX_CALLS_PER_SESSION=60
MAX_CALLS_PER_MINUTE=20
MAX_ESTIMATED_SPEND_USD=100

# Agent thresholds
CONFIDENCE_ADVANCE=0.7
CONFIDENCE_HIGH_RISK=0.85
WARNING_COOLDOWN_SECONDS=8

# CORS allowed origins (comma-separated or list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]
